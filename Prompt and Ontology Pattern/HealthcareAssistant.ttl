@prefix : <http://www.semanticweb.org/isha/ontologies/2026/7/untitled-ontology-5/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ontology: <http://www.example.org/ontology#> .
@base <http://www.semanticweb.org/isha/ontologies/2026/7/untitled-ontology-5/> .

<http://www.example.org/ontology#> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.example.org/ontology#hasMechanism
ontology:hasMechanism rdf:type owl:ObjectProperty ;
                      rdfs:domain ontology:Disease ;
                      rdfs:range ontology:Symptom .


###  http://www.example.org/ontology#hasSymptom
ontology:hasSymptom rdf:type owl:ObjectProperty ;
                    rdfs:domain ontology:Disease ;
                    rdfs:range ontology:Symptom .


###  http://www.example.org/ontology#treats
ontology:treats rdf:type owl:ObjectProperty ;
                rdfs:domain ontology:Drug ;
                rdfs:range ontology:Disease .


#################################################################
#    Classes
#################################################################

###  http://www.example.org/ontology#Disease
ontology:Disease rdf:type owl:Class .


###  http://www.example.org/ontology#Drug
ontology:Drug rdf:type owl:Class .


###  http://www.example.org/ontology#MechanismOfAction
ontology:MechanismOfAction rdf:type owl:Class .


###  http://www.example.org/ontology#Symptom
ontology:Symptom rdf:type owl:Class .


###  http://www.example.org/ontology#Treatment
ontology:Treatment rdf:type owl:Class .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdfs:subClassOf ontology:MechanismOfAction .


#################################################################
#    Individuals
#################################################################

###  http://www.example.org/ontology#Arthritis
ontology:Arthritis rdf:type owl:NamedIndividual ,
                            ontology:Disease ;
                   ontology:hasSymptom ontology:Joint_Pain .


###  http://www.example.org/ontology#COX_Inhibitor
ontology:COX_Inhibitor rdf:type owl:NamedIndividual ,
                                ontology:MechanismOfAction .


###  http://www.example.org/ontology#Ibuprofen
ontology:Ibuprofen rdf:type owl:NamedIndividual ,
                            ontology:Drug ;
                   ontology:hasMechanism ontology:COX_Inhibitor ;
                   ontology:treats ontology:Arthritis .


###  http://www.example.org/ontology#Joint_Pain
ontology:Joint_Pain rdf:type owl:NamedIndividual ,
                             ontology:Symptom .


