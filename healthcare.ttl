@prefix : <http://www.semanticweb.org/isha/ontologies/2026/7/untitled-ontology-4/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/isha/ontologies/2026/7/untitled-ontology-4/> .

<http://www.example.org/healthcare> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.example.org/healthcare#hasDisease
:hasDisease rdf:type owl:ObjectProperty .


###  http://www.example.org/healthcare#receivesTreatment
:receivesTreatment rdf:type owl:ObjectProperty .


###  http://www.example.org/healthcare#treatedBy
:treatedBy rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.example.org/healthcare#hasAge
:hasAge rdf:type owl:DatatypeProperty .


###  http://www.example.org/healthcare#hasName
:hasName rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://www.example.org/healthcare#Disease
:Disease rdf:type owl:Class .


###  http://www.example.org/healthcare#Doctor
:Doctor rdf:type owl:Class .


###  http://www.example.org/healthcare#Patient
:Patient rdf:type owl:Class .


###  http://www.example.org/healthcare#Treatment
:Treatment rdf:type owl:Class ;
           rdfs:subClassOf :Disease .


#################################################################
#    Individuals
#################################################################

###  http://www.example.org/healthcare#Alice
:Alice rdf:type owl:NamedIndividual ,
                :Patient ;
       :hasDisease :Diabetes ;
       :receivesTreatment :Insulin ;
       :treatedBy :DrSmith ;
       :hasAge 34 .


###  http://www.example.org/healthcare#Diabetes
:Diabetes rdf:type owl:NamedIndividual ,
                   :Disease ,
                   :Patient ;
          :hasName "Diabetes" .


###  http://www.example.org/healthcare#DrSmith
:DrSmith rdf:type owl:NamedIndividual ,
                  :Doctor ;
         :hasName "DrSmith" .


###  http://www.example.org/healthcare#Insulin
:Insulin rdf:type owl:NamedIndividual ,
                  :Patient ,
                  :Treatment ;
         :hasName "Insulin" .


